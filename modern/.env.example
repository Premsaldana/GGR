# Copy this file to .env.local once per machine. .env.local is ignored by Git
# and will be loaded automatically by `npm run dev` and `npm run start`.

# The parent folder and database file are created automatically on first start.
DATABASE_PROVIDER=sqlite
DATABASE_URL=./data/ggr.db
# PostgreSQL/Supabase uses the pooled or direct connection string from Project Settings.
# The application bootstraps the PostgreSQL schema from src/db/schema-postgres.sql.
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Replace this with a stable random value of at least 32 characters.
SESSION_SECRET=replace-this-with-a-stable-random-secret-at-least-32-characters

# Required only for Gmail OTP admin login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM=your-gmail-address
