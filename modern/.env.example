# Copy this file to .env.local once per machine. .env.local is ignored by Git
# and will be loaded automatically by `npm run dev` and `npm run start`.

# Use the database path that already exists on your machine.
DATABASE_URL=./data/ggr.db

# Replace this with a stable random value of at least 32 characters.
SESSION_SECRET=replace-this-with-a-stable-random-secret-at-least-32-characters

# Required only for Gmail OTP admin login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM=your-gmail-address
